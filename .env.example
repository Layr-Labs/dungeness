# Copy to .env; keep private and uncommitted. Set only your selected route inputs.
# ./dungeness providers --details lists inputs without reading any credentials.
# Dedicated upstream credentials are passed only to the gateway.
TESTBED_OPENAI_API_KEY=
TESTBED_OPENROUTER_API_KEY=
# Assert only after disabling account-default server tools/plugins.
TESTBED_OPENROUTER_INFERENCE_ONLY=
TESTBED_ANTHROPIC_API_KEY=
# Operator-configured provider credentials use TESTBED_<credential_env>.
# Define them privately according to the installed trusted registry.
# For ChatGPT access, callers supply DUNGENESS_CODEX_AUTH_FILE outside source.
# Newly compiled runs snapshot only required token fields into a private gateway
# mount; the original login file is unchanged. Login/refresh belongs to the caller.
