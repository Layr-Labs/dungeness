# Copy to .env. Dedicated upstream credentials are passed only to the gateway.
# EXA_API_KEY is required only when search/fetch has a nonzero budget.
EXA_API_KEY=
TESTBED_OPENAI_API_KEY=
TESTBED_OPENROUTER_API_KEY=
# Assert only after disabling account-default server tools/plugins.
TESTBED_OPENROUTER_INFERENCE_ONLY=
TESTBED_ANTHROPIC_API_KEY=
# Native Chat Completions routes; the harness owns protocol compatibility.
TESTBED_MOONSHOT_API_KEY=
TESTBED_KIMI_CODE_API_KEY=
# Configured compatible provider credentials:
TESTBED_XAI_API_KEY=
# For ChatGPT access, callers supply DUNGENESS_CODEX_AUTH_FILE outside source.
# That private temporary file is mounted only into the gateway, never the agent.
