# Copy this file to .env and fill in dedicated, budget-limited provider keys.
# Harbor reads .env on the host; this file is not copied into the agent image.
# EXA_API_KEY is required only when search or fetch has a nonzero budget.
EXA_API_KEY=

# OpenRouter agents. Real key -> gateway only. Codex profiles can select OpenAI
# or Kimi K3 through OpenRouter's Responses API; the editable submission agent
# currently uses OpenRouter Chat Completions.
TESTBED_OPENROUTER_API_KEY=
# Set to 1 only after disabling all default server tools/plugins in the
# OpenRouter account settings (including enforced "Prevent overrides" plugins).
# Without this operator assertion, the gateway rejects OpenRouter inference.
TESTBED_OPENROUTER_INFERENCE_ONLY=

# Optional direct OpenAI route for custom agents.
TESTBED_OPENAI_API_KEY=

# Optional direct Kimi K3 route through the gateway's Responses-to-Chat adapter.
# This is not needed by codex-kimi-openrouter.
TESTBED_MOONSHOT_API_KEY=

# Kimi Code membership route. Create this key in the Kimi Code console; it uses
# membership credits through https://api.kimi.com/coding/v1, not Open Platform
# pay-as-you-go billing.
TESTBED_KIMI_CODE_API_KEY=

# Codex subscription runs need no model API key. They use the host file-backed
# Codex login (`./dungeness auth status codex`), plus EXA_API_KEY when web
# search or fetch is enabled.

# Claude Code agents. `claude-openrouter` uses TESTBED_OPENROUTER_API_KEY
# above; the direct Anthropic profile (`claude`) needs this key. Real key ->
# gateway only. Do NOT set ANTHROPIC_BASE_URL here: `dungeness run` exports the
# selected agent's gateway route to Harbor, and a .env value would override it
# for every Claude profile.
TESTBED_ANTHROPIC_API_KEY=
