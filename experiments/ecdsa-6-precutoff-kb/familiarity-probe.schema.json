{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["papers", "overall_observation"],
  "properties": {
    "papers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["paper", "answers", "confidence"],
        "properties": {
          "paper": {"type": "string"},
          "answers": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "string"}
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "overall_observation": {"type": "string"}
  },
  "additionalProperties": false
}
