def build_command(args: argparse.Namespace, run_id: str) -> list[str]:
    command = [
        "uv",
        "run",
        str(BUILD_SCRIPT.relative_to(REPO_ROOT)),
        args.task,
        "--task-namespace",
        args.task_namespace,
        "--agent",
        args.agent,
        "--agent-namespace",
        args.agent_namespace,
        "--checkpoint",
        args.checkpoint,
        "--run-id",
        run_id,
        "--namespace",
        args.namespace,
    ]
    for flag, value in (
        ("--resume-from", args.resume_from),
        ("--max-model-tokens", args.max_model_tokens),
        ("--max-usd", args.max_usd),
        ("--agent-timeout-sec", getattr(args, "agent_timeout_sec", None)),
        ("--reasoning-effort", args.reasoning_effort),
        ("--reasoning-summary", args.reasoning_summary),
    ):
        if value is not None:
            command.extend((flag, str(value)))
    for label in args.label:
        command.extend(("--label", label))
    if args.fresh_start:
        command.append("--fresh-start")
    if getattr(args, "scaffold_start", False):
        command.append("--scaffold-start")
    if args.run_spec_path is not None:
        command.extend(("--run-spec", str(args.run_spec_path)))
        if args.run_spec_ref is not None:
            run_spec_namespace = (
                args.run_spec_ref.removeprefix("run-spec:").rsplit("/", 1)[0]
            )
            command.extend(("--run-spec-namespace", run_spec_namespace))
    return command


def execute_run(args: argparse.Namespace) -> int:
    args = resolve_run_spec_arguments(args)
    args.namespace = resolve_namespace(args.namespace)
    env_file = REPO_ROOT / args.env_file
    if not env_file.is_file():
        raise SystemExit(
            f"environment file not found: {env_file}\n"
            "Run ./dungeness setup first, then fill in the required provider keys."
        )

    run_id = args.run_id or default_run_id(args)
    run_dir = run_directory(args.namespace, run_id)
    if run_dir.exists() and any(run_dir.iterdir()):
        display_path = run_dir.relative_to(REPO_ROOT).as_posix()
        raise SystemExit(
            f"run already exists: {display_path}\n"
            "Run records are immutable; choose another --run-id."
        )
    print(
        ">> live transcript (run in another terminal): "
        + transcript_server_command(run_dir),
        flush=True,
    )
    print(
        ">> evaluation events (rerun as needed): "
        + evaluation_events_command(run_dir),
        flush=True,
    )
    check_docker_network_capacity()

    rendered_path: Path | None = None
    record_path: Path | None = None
    final_status = "failed"
    failure: str | None = None
    try:
        print(">> rendering temporary run task", flush=True)
        rendered_text = stream_command(build_command(args, run_id))
        rendered_path = Path(rendered_text)
        if not rendered_path.is_absolute():
            rendered_path = REPO_ROOT / rendered_path
        job_path = rendered_path / "harbor-job.yaml"
        if not job_path.is_file():
            raise RuntimeError(
                f"renderer did not produce a Harbor job at {job_path}"
            )
        control_plane_env = control_plane_agent_environment(job_path, env_file)
        environment, scrubbed_host_env = harbor_launch_environment(
            os.environ, control_plane_env
        )
        record_path = start_run_record(
            rendered_path,
            run_id,
            environment_file=args.env_file,
            keep_images=args.keep_images,
            control_plane_environment=control_plane_env,
            scrubbed_host_environment=scrubbed_host_env,
        )
        print(f">> recorded run {run_id}", flush=True)

        if scrubbed_host_env:
            print(
                ">> dropping host provider variables from the Harbor control plane: "
                + ", ".join(scrubbed_host_env),
                flush=True,
            )
        for key, value in control_plane_env.items():
            print(f">> exporting {key}={value} to the Harbor control plane", flush=True)
        adapter_path = str(REPO_ROOT / "adapters/harbor")
        existing_pythonpath = environment.get("PYTHONPATH")
        environment["PYTHONPATH"] = (
            adapter_path
            if not existing_pythonpath
            else adapter_path + os.pathsep + existing_pythonpath
        )
        print(f">> executing run from {job_path}", flush=True)
        with prepared_subscription_auth(args) as auth_environment:
            environment.update(auth_environment)
            stream_command(
                [
                    "uvx",
                    "--python",
                    "3.12",
                    "--from",
                    f"harbor=={HARBOR_VERSION}",
                    "--with",
                    f"litellm=={LITELLM_VERSION}",
                    "harbor",
                    "run",
                    "--env-file",
                    args.env_file,
                    "--config",
                    str(job_path),
                ],
                env=environment,
            )
        final_status = "completed"
    except KeyboardInterrupt:
        final_status = "cancelled"
        failure = "interrupted"
        raise
    except BaseException as error:
        failure = f"{type(error).__name__}: {error}"
        raise
    finally:
        teardown_run_environments(
            run_dir,
            remove_images=not args.keep_images,
        )
        if record_path is not None:
            try:
                finalize_run_record(
                    record_path,
                    status=final_status,
                    error=failure,
                )
            except Exception as error:
                if failure is None and final_status == "completed":
                    raise
                print(f">> warning: could not finalize run record: {error}", file=sys.stderr)
        if rendered_path is not None:
            retained_path = dispose_render(
                rendered_path,
                run_id,
                run_dir,
                keep=args.keep_render,
            )
            if retained_path is not None:
                print(f">> retained render at {retained_path}", flush=True)
            print(">> removed temporary run task", flush=True)
        events_path = run_dir / "usage" / "events.jsonl"
        timeline_path = run_dir / "usage" / "gateway-timeline.jsonl"
        audit_path = events_path if events_path.is_file() else timeline_path
        if audit_path.is_file():
            print(
                f">> usage events at {audit_path.relative_to(REPO_ROOT)}",
                flush=True,
            )
    return 0


