def build_command(args: argparse.Namespace, run_id: str) -> list[str]:
    command = [
        "uv",
        "run",
        str(BUILD_SCRIPT.relative_to(REPO_ROOT)),
        args.task,
        "--task-namespace",
        args.task_namespace,
        "--agent",
        args.agent,
        "--agent-namespace",
        args.agent_namespace,
        "--checkpoint",
        args.checkpoint,
        "--run-id",
        run_id,
        "--namespace",
        args.namespace,
    ]
    for flag, value in (
        ("--resume-from", args.resume_from),
        ("--max-model-tokens", args.max_model_tokens),
        ("--max-usd", args.max_usd),
        ("--agent-timeout-sec", getattr(args, "agent_timeout_sec", None)),
        ("--reasoning-effort", args.reasoning_effort),
        ("--reasoning-summary", args.reasoning_summary),
    ):
        if value is not None:
            command.extend((flag, str(value)))
    if getattr(args, "no_model_token_limit", False):
        command.append("--no-model-token-limit")
    for label in args.label:
        command.extend(("--label", label))
    if args.fresh_start:
        command.append("--fresh-start")
    if getattr(args, "scaffold_start", False):
        command.append("--scaffold-start")
    if args.run_spec_path is not None:
        command.extend(("--run-spec", str(args.run_spec_path)))
        if args.run_spec_ref is not None:
            run_spec_namespace = (
                args.run_spec_ref.removeprefix("run-spec:").rsplit("/", 1)[0]
            )
            command.extend(("--run-spec-namespace", run_spec_namespace))
    return command


def execute_run(args: argparse.Namespace) -> int:
    args = resolve_run_spec_arguments(args)
    args.namespace = resolve_namespace(args.namespace)
    env_file = REPO_ROOT / args.env_file
    if not env_file.is_file():
        raise SystemExit(
            f"environment file not found: {env_file}\n"
            "Run ./dungeness setup first, then fill in the required provider keys."
        )

    run_id = args.run_id or default_run_id(args)
    run_dir = run_directory(args.namespace, run_id)
    if run_dir.exists() and any(run_dir.iterdir()):
        display_path = run_dir.relative_to(REPO_ROOT).as_posix()
        raise SystemExit(
            f"run already exists: {display_path}\n"
            "Run records are immutable; choose another --run-id."
        )
    if (REPO_ROOT / "tools/transcripts/serve_gateway_transcripts.py").is_file():
        print(
            ">> live transcript (run in another terminal): "
            + transcript_server_command(run_dir),
            flush=True,
        )
    print(
        ">> evaluation events (rerun as needed): "
        + evaluation_events_command(run_dir),
        flush=True,
    )
    return execute_lifecycle(
        repository_root=REPO_ROOT, render_command=build_command(args, run_id),
        run_id=run_id, run_dir=run_dir, environment_file=args.env_file,
        keep_render=args.keep_render, keep_images=args.keep_images,
        start_record=start_run_record, finalize_record=finalize_run_record,
    )


