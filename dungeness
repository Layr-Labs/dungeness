def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace(
        "+00:00", "Z"
    )


def require_namespace(value: object, field: str = "namespace") -> str:
    if not isinstance(value, str) or not NAMESPACE_RE.fullmatch(value):
        raise SystemExit(
            f"{field} must be slash-separated lowercase namespace segments: {value!r}"
        )
    return value


def user_config_path(environment: dict[str, str] | None = None) -> Path:
    environment = os.environ if environment is None else environment
    override = environment.get("DUNGENESS_CONFIG")
    if override:
        return Path(override).expanduser()
    xdg_root = environment.get("XDG_CONFIG_HOME")
    config_root = Path(xdg_root).expanduser() if xdg_root else Path.home() / ".config"
    return config_root / "dungeness/config.toml"


def codex_auth_path(environment: dict[str, str] | None = None) -> Path:
    environment = os.environ if environment is None else environment
    override = environment.get("DUNGENESS_CODEX_AUTH_FILE")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".codex/auth.json"


def load_chatgpt_auth(path: Path) -> dict[str, object]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise SystemExit(
            f"Codex subscription credential not found: {path}\n"
            "Run: ./dungeness auth login codex"
        ) from error
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"invalid Codex subscription credential: {path}") from error
    tokens = document.get("tokens")
    if document.get("auth_mode") != "chatgpt" or not isinstance(tokens, dict):
        raise SystemExit(
            f"Codex credential is not a ChatGPT subscription login: {path}"
        )
    for key in ("access_token", "refresh_token"):
        if not isinstance(tokens.get(key), str) or not tokens[key]:
            raise SystemExit(f"Codex credential is missing {key}: {path}")
    return document


def codex_auth_command(args: argparse.Namespace) -> int:
    path = codex_auth_path()
    if args.auth_command == "status":
        document = load_chatgpt_auth(path)
        print("Codex subscription authentication: ready")
        print(f"Credential: {path}")
        if document.get("last_refresh"):
            print(f"Last refresh: {document['last_refresh']}")
        return 0

    if shutil.which("codex") is None:
        raise SystemExit("codex is not installed on the host")
    path.parent.mkdir(parents=True, exist_ok=True)
    environment = os.environ.copy()
    environment["CODEX_HOME"] = str(path.parent)
    command = ["codex", "login"]
    if args.device_auth:
        command.append("--device-auth")
    subprocess.run(command, env=environment, check=True)
    load_chatgpt_auth(path)
    print(f">> Codex subscription credential ready: {path}")
    return 0


def selected_agent_manifest(args: argparse.Namespace) -> dict[str, object]:
    path = find_local_record_path(
        "agent",
        args.agent_namespace,
        args.agent,
    )
    if path is None:
        raise SystemExit(
            f"agent is not installed locally: "
            f"agent:{args.agent_namespace}/{args.agent}"
        )
    document = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict):
        raise SystemExit(f"invalid agent manifest: {path}")
    return document


@contextmanager
def prepared_subscription_auth(
    args: argparse.Namespace,
):
    agent = selected_agent_manifest(args)
    if agent.get("execution", {}).get("interface") == "dungeness-command-v1":
        # Generic harnesses never receive native provider credentials. The
        # caller supplies a tmpfs access file mounted only into the gateway.
        yield {}
        return
    authentication = agent.get("authentication")
    if not (
        isinstance(authentication, dict)
        and authentication.get("mode") == "chatgpt-subscription"
    ):
        yield {}
        return

    source = codex_auth_path()
    load_chatgpt_auth(source)
    temporary_root = Path(
        tempfile.mkdtemp(prefix="dungeness-codex-auth-", dir=os.environ.get("DUNGENESS_AUTH_TMPDIR", "/tmp"))
    )
    temporary_root.chmod(0o700)
    temporary_auth = temporary_root / "auth.json"
    shutil.copy2(source, temporary_auth)
    temporary_auth.chmod(0o600)
    try:
        yield {"DUNGENESS_CODEX_AUTH_DIR": str(temporary_root)}
    finally:
        shutil.rmtree(temporary_root, ignore_errors=True)


def load_user_config(path: Path) -> dict[str, object]:
    with path.open("rb") as handle:
        config = tomllib.load(handle)
    if config.get("schema_version") != 1 or not isinstance(
        config.get("namespace"), str
    ):
        raise SystemExit(f"invalid Dungeness user config: {path}")
    return config


def resolve_namespace(
    explicit: str | None,
    *,
    environment: dict[str, str] | None = None,
    config_path: Path | None = None,
) -> str:
    environment = os.environ if environment is None else environment
    if explicit is not None:
        return require_namespace(explicit, "--namespace")
    from_environment = environment.get("DUNGENESS_NAMESPACE")
    if from_environment:
        return require_namespace(from_environment, "DUNGENESS_NAMESPACE")
    path = config_path or user_config_path(environment)
    if path.is_file():
        return require_namespace(
            load_user_config(path)["namespace"],
            f"namespace in {path}",
        )
    raise SystemExit(
        "no Dungeness namespace configured\n"
        "Run: ./dungeness init --namespace users/<name>\n"
        "Or set DUNGENESS_NAMESPACE for this command."
    )


def write_user_config(path: Path, namespace: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    temporary.write_text(
        f"schema_version = 1\nnamespace = {json.dumps(namespace)}\n",
        encoding="utf-8",
    )
    temporary.replace(path)


def ensure_namespace_directories(namespace: str) -> None:
    relative = Path(*require_namespace(namespace).split("/"))
    for collection in (
        "agents",
        "tasks",
        "experiments",
        "knowledge-bases",
        "run-specs",
        "runs",
    ):
        (REPO_ROOT / collection / relative).mkdir(parents=True, exist_ok=True)


def initialize(args: argparse.Namespace) -> int:
    namespace = require_namespace(args.namespace, "--namespace")
    path = user_config_path()
    if path.is_file():
        existing = load_user_config(path)
        if existing.get("namespace") == namespace:
            ensure_namespace_directories(namespace)
            print(f">> namespace already configured: {namespace}")
            print(path)
            return 0
        if not args.force:
            raise SystemExit(
                f"Dungeness user config already exists: {path}\n"
                "Pass --force to replace its namespace."
            )
    write_user_config(path, namespace)
    ensure_namespace_directories(namespace)
    print(f">> configured namespace {namespace}")
    print(path)
    return 0


def setup_environment(_args: argparse.Namespace) -> int:
    missing = [tool for tool in ("uv", "uvx", "docker") if shutil.which(tool) is None]
    if missing:
        raise SystemExit(
            "required tools not found on PATH: " + ", ".join(missing)
        )

    docker_info = subprocess.run(
        ["docker", "info"],
        cwd=REPO_ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if docker_info.returncode != 0:
        raise SystemExit(
            "Docker daemon is not running; start Docker Desktop or the Docker engine."
        )

    env_path = REPO_ROOT / ".env"
    if not env_path.is_file():
        example_path = REPO_ROOT / ".env.example"
        if not example_path.is_file():
            raise SystemExit(f"environment template not found: {example_path}")
        shutil.copyfile(example_path, env_path)
        print(">> created .env from .env.example")
        print(">> fill in the provider keys before starting a run")

    print(">> setup ok")
    if not user_config_path().is_file():
        print("Configure your record namespace once with:")
        print("  ./dungeness init --namespace users/<name>")
    return 0


def require_config_mapping(
    document: dict[str, object],
    field: str,
    allowed_fields: set[str],
) -> dict[str, object]:
    value = document.get(field, {})
    if not isinstance(value, dict):
        raise SystemExit(f"run spec {field} must be a mapping")
    unknown = sorted(set(value) - allowed_fields)
    if unknown:
        raise SystemExit(
            f"unknown run spec {field} fields: {', '.join(unknown)}"
        )
    return value


def validate_run_spec_web_search(document: dict[str, object]) -> None:
    if "web_search" not in document:
        return
    web_search = document["web_search"]
    if not isinstance(web_search, dict):
        raise SystemExit("run spec web_search must be a mapping")
    unknown = sorted(set(web_search) - {"profile"})
    if unknown:
        raise SystemExit(
            "unknown run spec web_search fields: " + ", ".join(unknown)
        )
    profile_ref = web_search.get("profile")
    if not isinstance(profile_ref, str) or not profile_ref.startswith(
        "web-search-profile:"
    ):
        raise SystemExit(
            "run spec web_search.profile must be a fully qualified "
            "web-search-profile reference"
        )
    raw_ref = profile_ref.removeprefix("web-search-profile:")
    namespace_value, separator, local_id = raw_ref.rpartition("/")
    if (
        not separator
        or not NAMESPACE_RE.fullmatch(namespace_value)
        or not LOCAL_ID_RE.fullmatch(local_id)
    ):
        raise SystemExit(
            "web-search-profile reference must be "
            "web-search-profile:<namespace>/<id>"
        )
    profile_path = (
        WEB_SEARCH_PROFILES_ROOT
        / Path(*namespace_value.split("/"))
        / f"{local_id}.yaml"
    )
    if not profile_path.is_file():
        raise SystemExit(f"web-search profile does not exist: {profile_ref}")
    profile = yaml.safe_load(profile_path.read_text(encoding="utf-8"))
    if (
        not isinstance(profile, dict)
        or profile.get("schema_version") != 1
        or profile.get("type") != "web-search-profile"
        or profile.get("namespace") != namespace_value
        or profile.get("id") != local_id
        or not isinstance(profile.get("mode"), str)
        or not isinstance(profile.get("prompt"), str)
    ):
        raise SystemExit(f"invalid web-search profile: {profile_ref}")


